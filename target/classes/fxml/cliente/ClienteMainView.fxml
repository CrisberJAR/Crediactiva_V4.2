<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.cliente.ClienteMainController">
   <top>
      <VBox spacing="15.0" styleClass="modern-card">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         
         <HBox alignment="CENTER_LEFT" spacing="15.0">
            <Label text="🏦" styleClass="logo-placeholder" />
            <Label styleClass="section-title" text="CrediActiva - Portal del Cliente" />
         </HBox>
         
         <!-- Información del cliente -->
         <HBox spacing="25.0" alignment="CENTER_LEFT">
            <Label fx:id="lblClienteInfo" styleClass="info-label" text="Cliente: " />
            <Label fx:id="lblFechaHoy" styleClass="info-label" text="Fecha: " />
            <Label fx:id="lblCapitalAcumulado" styleClass="success-label" text="Capital Acumulado: S/ 0.00" />
            <Label fx:id="lblEtiquetaCliente" styleClass="warning-label" text="Etiqueta: " />
         </HBox>
      </VBox>
   </top>
   
   <center>
      <SplitPane dividerPositions="0.3" orientation="HORIZONTAL">
         <!-- Panel izquierdo: Menú de opciones -->
         <VBox spacing="15.0" styleClass="modern-panel">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <Label text="📋 Opciones del Cliente" styleClass="section-title" />
            
            <Button fx:id="btnResumen" onAction="#handleResumen" styleClass="quick-action-button" text="📊 Mi Resumen" />
            <Button fx:id="btnPrestamos" onAction="#handlePrestamos" styleClass="quick-action-button" text="💳 Mis Préstamos" />
            <Button fx:id="btnCronogramas" onAction="#handleCronogramas" styleClass="quick-action-button" text="📅 Mis Cronogramas" />
            <Button fx:id="btnRecibos" onAction="#handleRecibos" styleClass="quick-action-button" text="📄 Mis Recibos" />
            <Button fx:id="btnSimulador" onAction="#handleSimulador" styleClass="modern-button" text="🚀 Simulador de Crédito" />
            <Button fx:id="btnHistorial" onAction="#handleHistorial" styleClass="quick-action-button" text="📈 Mi Historial" />
            <Button fx:id="btnLogout" onAction="#handleLogout" styleClass="logout-button" text="Cerrar Sesión" />
         </VBox>
         
         <!-- Panel derecho: Contenido dinámico -->
         <VBox fx:id="contentArea" spacing="10.0">
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            
            <!-- Resumen por defecto -->
            <Label text="Mi Resumen" styleClass="title-label">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            
            <!-- Información personal -->
            <VBox spacing="10.0">
               <Label text="Información Personal" styleClass="section-title" />
               <GridPane hgap="10.0" vgap="10.0">
                  <columnConstraints>
                     <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                     <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                     <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                     <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints minHeight="30.0" vgrow="NEVER" />
                     <RowConstraints minHeight="30.0" vgrow="NEVER" />
                     <RowConstraints minHeight="30.0" vgrow="NEVER" />
                     <RowConstraints minHeight="30.0" vgrow="NEVER" />
                  </rowConstraints>
                  
                  <Label text="DNI:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <Label fx:id="lblDni" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <Label fx:id="lblNombre" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                  
                  <Label text="Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <Label fx:id="lblApellido" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Teléfono:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <Label fx:id="lblTelefono" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                  
                  <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <Label fx:id="lblEmail" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Asesor:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <Label fx:id="lblAsesor" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                  
                  <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <Label fx:id="lblDireccion" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="3" />
               </GridPane>
            </VBox>
            
            <!-- Resumen financiero -->
            <VBox spacing="10.0">
               <Label text="Resumen Financiero" styleClass="section-title" />
               <GridPane hgap="10.0" vgap="10.0">
                  <columnConstraints>
                     <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                     <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                     <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                     <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints minHeight="80.0" vgrow="ALWAYS" />
                     <RowConstraints minHeight="80.0" vgrow="ALWAYS" />
                  </rowConstraints>
                  
                  <!-- Capital acumulado -->
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <Label text="Capital Acumulado" styleClass="stat-label" />
                     <Label fx:id="lblCapitalAcumuladoCard" text="S/ 0.00" styleClass="stat-value" />
                     <Label text="10% por préstamo" styleClass="stat-description" />
                  </VBox>
                  
                  <!-- Préstamos activos -->
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <Label text="Préstamos Activos" styleClass="stat-label" />
                     <Label fx:id="lblPrestamosActivos" text="0" styleClass="stat-value" />
                     <Label text="En curso" styleClass="stat-description" />
                  </VBox>
                  
                  <!-- Cuotas pendientes -->
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                     <Label text="Cuotas Pendientes" styleClass="stat-label" />
                     <Label fx:id="lblCuotasPendientes" text="0" styleClass="stat-value" />
                     <Label text="Por pagar" styleClass="stat-description" />
                  </VBox>
                  
                  <!-- Cuotas vencidas -->
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                     <Label text="Cuotas Vencidas" styleClass="stat-label" />
                     <Label fx:id="lblCuotasVencidas" text="0" styleClass="stat-value" />
                     <Label text="Retrasadas" styleClass="stat-description" />
                  </VBox>
                  
                  <!-- Monto total pagado -->
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <Label text="Total Pagado" styleClass="stat-label" />
                     <Label fx:id="lblTotalPagado" text="S/ 0.00" styleClass="stat-value" />
                     <Label text="Histórico" styleClass="stat-description" />
                  </VBox>
                  
                  <!-- Monto pendiente -->
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <Label text="Monto Pendiente" styleClass="stat-label" />
                     <Label fx:id="lblMontoPendiente" text="S/ 0.00" styleClass="stat-value" />
                     <Label text="Por pagar" styleClass="stat-description" />
                  </VBox>
                  
                  <!-- Etiqueta de cliente -->
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                     <Label text="Etiqueta" styleClass="stat-label" />
                     <Label fx:id="lblEtiquetaClienteCard" text="Excelente" styleClass="stat-value" />
                     <Label text="Calificación" styleClass="stat-description" />
                  </VBox>
                  
                  <!-- Último pago -->
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card" GridPane.columnIndex="3" GridPane.rowIndex="1">
                     <Label text="Último Pago" styleClass="stat-label" />
                     <Label fx:id="lblUltimoPago" text="--" styleClass="stat-value" />
                     <Label text="Fecha" styleClass="stat-description" />
                  </VBox>
               </GridPane>
            </VBox>
            
            <!-- Acciones rápidas -->
            <VBox spacing="10.0">
               <Label text="Acciones Rápidas" styleClass="section-title" />
               <HBox spacing="10.0" alignment="CENTER">
                  <padding>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
                  
                  <Button fx:id="btnVerPrestamos" onAction="#handleVerPrestamos" styleClass="quick-action-button" text="Ver Mis Préstamos" />
                  <Button fx:id="btnVerCronogramas" onAction="#handleVerCronogramas" styleClass="quick-action-button" text="Ver Cronogramas" />
                  <Button fx:id="btnSimularCredito" onAction="#handleSimularCredito" styleClass="quick-action-button" text="Simular Crédito" />
                  <Button fx:id="btnDescargarRecibos" onAction="#handleDescargarRecibos" styleClass="quick-action-button" text="Descargar Recibos" />
               </HBox>
            </VBox>
         </VBox>
      </SplitPane>
   </center>
   
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Label fx:id="lblUltimaActualizacion" text="Última actualización: " />
      </HBox>
   </bottom>
</BorderPane>
