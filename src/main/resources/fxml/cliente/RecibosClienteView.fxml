<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.cliente.RecibosClienteController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="btnVolver" onAction="#handleVolver" styleClass="modern-button" text="← Volver" />
            <Label text="Descargar Recibos" styleClass="section-title" />
         </HBox>
         
         <Label text="Descarga recibos de pago y comprobantes de préstamos" styleClass="modern-label subtitle" />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" vbarPolicy="NEVER">
         <VBox spacing="20.0">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- Panel de filtros -->
            <VBox spacing="15.0" styleClass="modern-card">
               <Label text="Filtros de Búsqueda" styleClass="section-title" />
               
               <GridPane hgap="15.0" vgap="15.0">
                  <columnConstraints>
                     <ColumnConstraints minWidth="150.0" />
                     <ColumnConstraints />
                     <ColumnConstraints minWidth="150.0" />
                     <ColumnConstraints />
                  </columnConstraints>
                  
                  <Label text="Préstamo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <ComboBox fx:id="comboPrestamo" onAction="#handleFiltrar" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="combo-box" />
                  
                  <Label text="Tipo de documento:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <ComboBox fx:id="comboTipoDocumento" onAction="#handleFiltrar" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="combo-box" />
                  
                  <Label text="Fecha desde:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <DatePicker fx:id="dateDesde" onAction="#handleFiltrar" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="date-picker" />
                  
                  <Label text="Fecha hasta:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <DatePicker fx:id="dateHasta" onAction="#handleFiltrar" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="date-picker" />
               </GridPane>
               
               <HBox spacing="10.0" alignment="CENTER">
                  <Button fx:id="btnBuscar" onAction="#handleBuscar" styleClass="modern-button" text="Buscar" />
                  <Button fx:id="btnLimpiar" onAction="#handleLimpiar" styleClass="quick-action-button" text="Limpiar Filtros" />
               </HBox>
            </VBox>
            
            <!-- Panel de documentos disponibles -->
            <VBox spacing="15.0" styleClass="modern-card">
               <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <Label text="Documentos Disponibles" styleClass="section-title" />
                  <Label fx:id="lblTotalDocumentos" styleClass="modern-label info" />
               </HBox>
               
               <TableView fx:id="tablaDocumentos" prefHeight="300.0" styleClass="table-view">
                  <columns>
                     <TableColumn fx:id="colTipoDocumento" prefWidth="150.0" text="Tipo" />
                     <TableColumn fx:id="colPrestamo" prefWidth="120.0" text="Préstamo" />
                     <TableColumn fx:id="colFechaDocumento" prefWidth="120.0" text="Fecha" />
                     <TableColumn fx:id="colMonto" prefWidth="120.0" text="Monto" />
                     <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                     <TableColumn fx:id="colAcciones" prefWidth="150.0" text="Acciones" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Panel de acciones masivas -->
            <VBox spacing="15.0" styleClass="modern-card">
               <Label text="Acciones Masivas" styleClass="section-title" />
               
               <HBox spacing="10.0" alignment="CENTER_LEFT">
                  <CheckBox fx:id="checkSeleccionarTodos" onAction="#handleSeleccionarTodos" text="Seleccionar todos los documentos visibles" />
               </HBox>
               
               <HBox spacing="10.0" alignment="CENTER">
                  <Button fx:id="btnDescargarSeleccionados" onAction="#handleDescargarSeleccionados" styleClass="modern-button" text="Descargar Seleccionados" />
                  <Button fx:id="btnGenerarPaquete" onAction="#handleGenerarPaquete" styleClass="quick-action-button" text="Generar Paquete ZIP" />
               </HBox>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox alignment="CENTER" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>
         
         <Label text="📄 Los documentos se descargan en formato PDF" styleClass="modern-label info" />
      </HBox>
   </bottom>
</BorderPane>
