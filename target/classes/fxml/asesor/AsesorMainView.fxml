<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.asesor.AsesorMainController" styleClass="asesor-main-container">
   <top>
      <VBox styleClass="asesor-header" spacing="15.0">
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         
         <!-- Título principal -->
         <Label styleClass="asesor-title" text="CrediActiva - Asesor" />
         
         <!-- Información del asesor en contenedor moderno -->
         <HBox styleClass="asesor-info-container" spacing="30.0" alignment="CENTER_LEFT">
            <Label fx:id="lblAsesorInfo" styleClass="asesor-info-label" text="👤 Asesor: " />
            <Label fx:id="lblFechaHoy" styleClass="asesor-info-label" text="📅 Fecha: " />
            <Label fx:id="lblRecaudacionMes" styleClass="asesor-info-label" text="💰 Recaudación Mes: S/ 0.00" />
            <Label fx:id="lblSueldoEstimado" styleClass="asesor-info-label" text="💵 Sueldo Estimado: S/ 0.00" />
         </HBox>
      </VBox>
   </top>
   
   <center>
      <SplitPane dividerPositions="0.25" orientation="HORIZONTAL">
         <!-- Panel izquierdo: Menú de opciones moderno -->
         <VBox styleClass="asesor-sidebar" spacing="8.0">
            <padding>
               <Insets bottom="25.0" left="20.0" right="20.0" top="25.0" />
            </padding>
            
            <Label text="⚙️ Opciones del Asesor" styleClass="asesor-menu-title" />
            
            <!-- Espaciado -->
            <Region prefHeight="10.0" />
            
            <!-- Botones del menú con iconos -->
            <Button fx:id="btnDashboard" onAction="#handleDashboard" styleClass="menu-button" text="📊 Dashboard" />
            <Button fx:id="btnClientes" onAction="#handleClientes" styleClass="menu-button" text="👥 Gestión de Clientes" />
            <Button fx:id="btnSolicitarPrestamo" onAction="#handleSolicitarPrestamo" styleClass="menu-button" text="📝 Solicitar Préstamo" />
            <Button fx:id="btnSimulador" onAction="#handleSimulador" styleClass="menu-button" text="🧮 Simulador de Crédito" />
            <Button fx:id="btnRegistrarCobro" onAction="#handleRegistrarCobro" styleClass="menu-button" text="💳 Registrar Cobro" />
            <Button fx:id="btnCartera" onAction="#handleCartera" styleClass="menu-button" text="💼 Mi Cartera" />
            <Button fx:id="btnReportes" onAction="#handleReportes" styleClass="menu-button" text="📈 Mis Reportes" />
            
            <!-- Espaciado antes del logout -->
            <Region prefHeight="20.0" />
            
            <!-- Botón de logout -->
            <Button fx:id="btnLogout" onAction="#handleLogout" styleClass="logout-button" text="🚪 Cerrar Sesión" />
         </VBox>
         
         <!-- Panel derecho: Contenido dinámico -->
         <VBox fx:id="contentArea" styleClass="asesor-content-area" spacing="20.0">
            <padding>
               <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
            </padding>
            
            <!-- Dashboard por defecto -->
            <Label text="📊 Dashboard del Asesor" styleClass="modern-title" />
            
            <!-- Estadísticas del día en grid moderno -->
            <GridPane hgap="20.0" vgap="20.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="140.0" vgrow="ALWAYS" />
                  <RowConstraints minHeight="140.0" vgrow="ALWAYS" />
               </rowConstraints>
               
               <!-- Cuotas del día -->
               <VBox alignment="CENTER" spacing="8.0" styleClass="modern-stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                  <Label text="📅" styleClass="stat-icon" />
                  <Label text="Cuotas del Día" styleClass="stat-label" />
                  <Label fx:id="lblCuotasDia" text="0" styleClass="stat-value" />
                  <Button fx:id="btnVerCuotasDia" onAction="#handleVerCuotasDia" styleClass="stat-button" text="Ver Detalles" />
               </VBox>
               
               <!-- Cuotas vencidas -->
               <VBox alignment="CENTER" spacing="8.0" styleClass="modern-stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                  <Label text="⚠️" styleClass="stat-icon" />
                  <Label text="Cuotas Vencidas" styleClass="stat-label" />
                  <Label fx:id="lblCuotasVencidas" text="0" styleClass="stat-value" />
                  <Button fx:id="btnVerCuotasVencidas" onAction="#handleVerCuotasVencidas" styleClass="stat-button" text="Ver Detalles" />
               </VBox>
               
               <!-- Recaudación del día -->
               <VBox alignment="CENTER" spacing="8.0" styleClass="modern-stat-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                  <Label text="💰" styleClass="stat-icon" />
                  <Label text="Recaudación del Día" styleClass="stat-label" />
                  <Label fx:id="lblRecaudacionDia" text="S/ 0.00" styleClass="stat-value" />
                  <Button fx:id="btnVerRecaudacionDia" onAction="#handleVerRecaudacionDia" styleClass="stat-button" text="Ver Detalles" />
               </VBox>
               
               <!-- Recaudación del mes -->
               <VBox alignment="CENTER" spacing="8.0" styleClass="modern-stat-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                  <Label text="📊" styleClass="stat-icon" />
                  <Label text="Recaudación del Mes" styleClass="stat-label" />
                  <Label fx:id="lblRecaudacionMesCard" text="S/ 0.00" styleClass="stat-value" />
                  <Button fx:id="btnVerRecaudacionMes" onAction="#handleVerRecaudacionMes" styleClass="stat-button" text="Ver Detalles" />
               </VBox>
               
               <!-- Clientes activos -->
               <VBox alignment="CENTER" spacing="8.0" styleClass="modern-stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                  <Label text="👥" styleClass="stat-icon" />
                  <Label text="Clientes Activos" styleClass="stat-label" />
                  <Label fx:id="lblClientesActivos" text="0" styleClass="stat-value" />
                  <Button fx:id="btnVerClientesActivos" onAction="#handleVerClientesActivos" styleClass="stat-button" text="Ver Detalles" />
               </VBox>
               
               <!-- Préstamos activos -->
               <VBox alignment="CENTER" spacing="8.0" styleClass="modern-stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                  <Label text="📋" styleClass="stat-icon" />
                  <Label text="Préstamos Activos" styleClass="stat-label" />
                  <Label fx:id="lblPrestamosActivos" text="0" styleClass="stat-value" />
                  <Button fx:id="btnVerPrestamosActivos" onAction="#handleVerPrestamosActivos" styleClass="stat-button" text="Ver Detalles" />
               </VBox>
               
               <!-- Morosidad -->
               <VBox alignment="CENTER" spacing="8.0" styleClass="modern-stat-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                  <Label text="📉" styleClass="stat-icon" />
                  <Label text="Morosidad" styleClass="stat-label" />
                  <Label fx:id="lblMorosidad" text="0%" styleClass="stat-value" />
                  <Button fx:id="btnVerMorosidad" onAction="#handleVerMorosidad" styleClass="stat-button" text="Ver Detalles" />
               </VBox>
               
               <!-- Sueldo estimado -->
               <VBox alignment="CENTER" spacing="8.0" styleClass="modern-stat-card" GridPane.columnIndex="3" GridPane.rowIndex="1">
                  <Label text="💵" styleClass="stat-icon" />
                  <Label text="Sueldo Estimado" styleClass="stat-label" />
                  <Label fx:id="lblSueldoEstimadoCard" text="S/ 0.00" styleClass="stat-value" />
                  <Button fx:id="btnVerSueldoEstimado" onAction="#handleVerSueldoEstimado" styleClass="stat-button" text="Ver Detalles" />
               </VBox>
            </GridPane>
            
            <!-- Acciones rápidas -->
            <VBox styleClass="quick-actions-section" spacing="15.0">
               <Label text="⚡ Acciones Rápidas" styleClass="modern-section-title" />
               <HBox spacing="15.0" alignment="CENTER_LEFT">
                  <padding>
                     <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
                  </padding>
                  
                  <Button fx:id="btnNuevoCliente" onAction="#handleNuevoCliente" styleClass="quick-action-button" text="👤 Nuevo Cliente" />
                  <Button fx:id="btnNuevaSolicitud" onAction="#handleNuevaSolicitud" styleClass="quick-action-button" text="📝 Nueva Solicitud" />
                  <Button fx:id="btnRegistrarPago" onAction="#handleRegistrarPago" styleClass="quick-action-button" text="💳 Registrar Pago" />
                  <Button fx:id="btnSimularCredito" onAction="#handleSimularCredito" styleClass="quick-action-button" text="🧮 Simular Crédito" />
               </HBox>
            </VBox>
         </VBox>
      </SplitPane>
   </center>
   
   <bottom>
      <HBox styleClass="modern-footer" alignment="CENTER_RIGHT" spacing="15.0">
         <padding>
            <Insets bottom="15.0" left="30.0" right="30.0" top="15.0" />
         </padding>
         
         <Label fx:id="lblUltimaActualizacion" styleClass="footer-text" text="🕒 Última actualización: " />
      </HBox>
   </bottom>
</BorderPane>
