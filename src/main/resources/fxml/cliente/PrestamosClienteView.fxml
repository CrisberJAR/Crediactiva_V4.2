<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.cliente.PrestamosClienteController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="btnVolver" onAction="#handleVolver" styleClass="modern-button" text="← Volver" />
            <Label text="Mis Préstamos" styleClass="section-title" />
         </HBox>
         
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Filtrar por estado:" />
            <ComboBox fx:id="comboEstadoFiltro" onAction="#handleFiltrar" prefWidth="150.0" />
            <Button fx:id="btnActualizar" onAction="#handleActualizar" styleClass="quick-action-button" text="Actualizar" />
         </HBox>
      </VBox>
   </top>
   
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>
         
         <!-- Tabla de préstamos -->
         <TableView fx:id="tablaPrestamos" prefHeight="400.0" styleClass="table-view">
            <columns>
               <TableColumn fx:id="colIdPrestamo" prefWidth="80.0" text="ID" />
               <TableColumn fx:id="colMontoSolicitado" prefWidth="120.0" text="Monto Solicitado" />
               <TableColumn fx:id="colMontoDesembolsado" prefWidth="120.0" text="Monto Desembolsado" />
               <TableColumn fx:id="colTasaInteres" prefWidth="100.0" text="Tasa (%)" />
               <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
               <TableColumn fx:id="colEtiqueta" prefWidth="100.0" text="Etiqueta" />
               <TableColumn fx:id="colFechaInicio" prefWidth="110.0" text="Fecha Inicio" />
               <TableColumn fx:id="colFechaFin" prefWidth="110.0" text="Fecha Fin" />
               <TableColumn fx:id="colObservacion" prefWidth="200.0" text="Observación" />
            </columns>
         </TableView>
         
         <!-- Información del préstamo seleccionado -->
         <VBox fx:id="panelDetalles" spacing="10.0" styleClass="modern-card" visible="false">
            <Label text="Detalles del Préstamo Seleccionado" styleClass="section-title" />
            <GridPane hgap="10.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="150.0" />
                  <ColumnConstraints />
                  <ColumnConstraints minWidth="150.0" />
                  <ColumnConstraints />
               </columnConstraints>
               
               <Label text="ID Préstamo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <Label fx:id="lblDetalleIdPrestamo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               
               <Label text="Monto Solicitado:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
               <Label fx:id="lblDetalleMontoSolicitado" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               
               <Label text="Monto Desembolsado:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
               <Label fx:id="lblDetalleMontoDesembolsado" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               
               <Label text="Tasa de Interés:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
               <Label fx:id="lblDetalleTasaInteres" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               
               <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
               <Label fx:id="lblDetalleEstado" GridPane.columnIndex="3" GridPane.rowIndex="0" />
               
               <Label text="Etiqueta:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
               <Label fx:id="lblDetalleEtiqueta" GridPane.columnIndex="3" GridPane.rowIndex="1" />
               
               <Label text="Fecha Inicio:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
               <Label fx:id="lblDetalleFechaInicio" GridPane.columnIndex="3" GridPane.rowIndex="2" />
               
               <Label text="Fecha Fin:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
               <Label fx:id="lblDetalleFechaFin" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            </GridPane>
            
            <Label text="Observación:" />
            <TextArea fx:id="txtDetalleObservacion" editable="false" prefHeight="60.0" wrapText="true" />
         </VBox>
      </VBox>
   </center>
   
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>
         
         <Label fx:id="lblTotalPrestamos" text="Total de préstamos: 0" />
      </HBox>
   </bottom>
</BorderPane>
