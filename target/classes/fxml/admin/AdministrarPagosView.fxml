<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.admin.AdministrarPagosController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Label styleClass="title-label" text="Administrar Pagos - Cierre del Día">
            <font>
               <Font size="18.0" />
            </font>
         </Label>
         
         <!-- Filtros -->
         <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Filtros:" />
            <ComboBox fx:id="comboAsesor" promptText="Asesor" prefWidth="150.0" />
            <DatePicker fx:id="dateFecha" promptText="Fecha" />
            <Button fx:id="btnFiltrar" onAction="#handleFiltrar" text="Filtrar" />
            <Button fx:id="btnLimpiarFiltros" onAction="#handleLimpiarFiltros" text="Limpiar" />
         </HBox>
      </VBox>
   </top>
   
   <center>
      <SplitPane dividerPositions="0.5" orientation="HORIZONTAL">
         <!-- Panel izquierdo: Borradores de recaudación -->
         <VBox spacing="10.0">
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            
            <Label text="Borradores de Recaudación del Día" styleClass="subtitle-label">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            
            <TableView fx:id="tablaBorradores" prefHeight="400.0">
               <columns>
                  <TableColumn fx:id="colBorradorId" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="colBorradorAsesor" prefWidth="100.0" text="Asesor" />
                  <TableColumn fx:id="colBorradorCliente" prefWidth="120.0" text="Cliente" />
                  <TableColumn fx:id="colBorradorPrestamo" prefWidth="80.0" text="Préstamo" />
                  <TableColumn fx:id="colBorradorMonto" prefWidth="100.0" text="Monto" />
                  <TableColumn fx:id="colBorradorFecha" prefWidth="120.0" text="Fecha" />
                  <TableColumn fx:id="colBorradorValidado" prefWidth="80.0" text="Validado" />
               </columns>
            </TableView>
            
            <!-- Botones de acción para borradores -->
            <HBox spacing="10.0" alignment="CENTER">
               <Button fx:id="btnValidarBorrador" onAction="#handleValidarBorrador" styleClass="success-button" text="Validar Borrador" />
               <Button fx:id="btnValidarTodos" onAction="#handleValidarTodos" styleClass="primary-button" text="Validar Todos" />
               <Button fx:id="btnEliminarBorrador" onAction="#handleEliminarBorrador" styleClass="danger-button" text="Eliminar Borrador" />
            </HBox>
         </VBox>
         
         <!-- Panel derecho: Aplicación de pagos -->
         <VBox spacing="10.0">
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            
            <Label text="Aplicación de Pagos a Cuotas" styleClass="subtitle-label">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            
            <!-- Información del cliente seleccionado -->
            <GroupBox text="Información del Cliente">
               <VBox spacing="5.0">
                  <padding>
                     <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                  </padding>
                  
                  <GridPane hgap="10.0" vgap="5.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
                        <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="25.0" vgrow="NEVER" />
                        <RowConstraints minHeight="25.0" vgrow="NEVER" />
                     </rowConstraints>
                     
                     <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                     <Label fx:id="lblCliente" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                     <Label text="Préstamo:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                     <Label fx:id="lblPrestamo" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                     
                     <Label text="Monto Pagado:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                     <Label fx:id="lblMontoPagado" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     <Label text="Saldo Pendiente:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                     <Label fx:id="lblSaldoPendiente" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                  </GridPane>
               </VBox>
            </GroupBox>
            
            <!-- Cuotas del préstamo -->
            <TableView fx:id="tablaCuotas" prefHeight="250.0">
               <columns>
                  <TableColumn fx:id="colCuotaNumero" prefWidth="60.0" text="Cuota" />
                  <TableColumn fx:id="colCuotaFecha" prefWidth="100.0" text="Fecha" />
                  <TableColumn fx:id="colCuotaMonto" prefWidth="100.0" text="Monto" />
                  <TableColumn fx:id="colCuotaEstado" prefWidth="100.0" text="Estado" />
                  <TableColumn fx:id="colCuotaAplicar" prefWidth="80.0" text="Aplicar" />
               </columns>
            </TableView>
            
            <!-- Botones de acción para cuotas -->
            <HBox spacing="10.0" alignment="CENTER">
               <Button fx:id="btnAplicarPagos" onAction="#handleAplicarPagos" styleClass="success-button" text="Aplicar Pagos" />
               <Button fx:id="btnAplicarVencidas" onAction="#handleAplicarVencidas" styleClass="warning-button" text="Aplicar a Vencidas" />
               <Button fx:id="btnLimpiarSeleccion" onAction="#handleLimpiarSeleccion" text="Limpiar Selección" />
            </HBox>
         </VBox>
      </SplitPane>
   </center>
   
   <bottom>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <!-- Resumen del día -->
         <HBox spacing="20.0" alignment="CENTER">
            <Label fx:id="lblTotalBorradores" text="Total Borradores: 0" />
            <Label fx:id="lblTotalMonto" text="Total Monto: S/ 0.00" />
            <Label fx:id="lblBorradoresValidados" text="Validados: 0" />
            <Label fx:id="lblBorradoresPendientes" text="Pendientes: 0" />
         </HBox>
         
         <!-- Botones de cierre -->
         <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="btnGenerarReporte" onAction="#handleGenerarReporte" text="Generar Reporte" />
            <Button fx:id="btnCerrarDia" onAction="#handleCerrarDia" styleClass="success-button" text="Cerrar Día" />
         </HBox>
      </VBox>
   </bottom>
</BorderPane>
