<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.admin.BandejaSolicitudesController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Label styleClass="title-label" text="Bandeja de Solicitudes de Préstamo">
            <font>
               <Font size="18.0" />
            </font>
         </Label>
         
         <!-- Filtros -->
         <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Filtros:" />
            <ComboBox fx:id="comboAsesor" promptText="Asesor" prefWidth="150.0" />
            <ComboBox fx:id="comboEstado" promptText="Estado" prefWidth="150.0" />
            <ComboBox fx:id="comboEtiqueta" promptText="Etiqueta Cliente" prefWidth="150.0" />
            <TextField fx:id="txtMontoMin" promptText="Monto Mínimo" prefWidth="120.0" />
            <TextField fx:id="txtMontoMax" promptText="Monto Máximo" prefWidth="120.0" />
            <Button fx:id="btnFiltrar" onAction="#handleFiltrar" text="Filtrar" />
            <Button fx:id="btnLimpiarFiltros" onAction="#handleLimpiarFiltros" text="Limpiar" />
         </HBox>
      </VBox>
   </top>
   
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <!-- Tabla de solicitudes -->
         <TableView fx:id="tablaSolicitudes" prefHeight="400.0">
            <columns>
               <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
               <TableColumn fx:id="colCliente" prefWidth="120.0" text="Cliente" />
               <TableColumn fx:id="colAsesor" prefWidth="100.0" text="Asesor" />
               <TableColumn fx:id="colMonto" prefWidth="100.0" text="Monto" />
               <TableColumn fx:id="colTasa" prefWidth="80.0" text="Tasa %" />
               <TableColumn fx:id="colPeriodo" prefWidth="80.0" text="Período" />
               <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
               <TableColumn fx:id="colEtiqueta" prefWidth="100.0" text="Etiqueta" />
               <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha" />
               <TableColumn fx:id="colObservacion" prefWidth="150.0" text="Observación" />
            </columns>
         </TableView>
         
         <!-- Información del préstamo seleccionado -->
         <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
               <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
               <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
               <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
               <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints minHeight="30.0" vgrow="NEVER" />
               <RowConstraints minHeight="30.0" vgrow="NEVER" />
               <RowConstraints minHeight="30.0" vgrow="NEVER" />
               <RowConstraints minHeight="30.0" vgrow="NEVER" />
            </rowConstraints>
            
            <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="lblCliente" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Asesor:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <Label fx:id="lblAsesor" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            
            <Label text="Monto Solicitado:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="lblMontoSolicitado" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Monto Desembolsado:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Label fx:id="lblMontoDesembolsado" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            
            <Label text="Tasa de Interés:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtTasaInteres" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Período (meses):" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextField fx:id="txtPeriodo" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            
            <Label text="Tipo de Pago:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <ComboBox fx:id="comboTipoPago" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Observación:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <TextField fx:id="txtObservacion" GridPane.columnIndex="3" GridPane.rowIndex="3" />
         </GridPane>
         
         <!-- Botones de acción -->
         <HBox spacing="10.0" alignment="CENTER">
            <Button fx:id="btnAprobar" onAction="#handleAprobar" styleClass="success-button" text="Aprobar y Generar Cronograma" />
            <Button fx:id="btnRechazar" onAction="#handleRechazar" styleClass="danger-button" text="Rechazar" />
            <Button fx:id="btnGuardar" onAction="#handleGuardar" styleClass="primary-button" text="Guardar Cambios" />
            <Button fx:id="btnVerHistorial" onAction="#handleVerHistorial" text="Ver Historial Cliente" />
         </HBox>
      </VBox>
   </center>
   
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Label fx:id="lblTotalSolicitudes" text="Total: 0 solicitudes" />
         <Label fx:id="lblSolicitudesPendientes" text="Pendientes: 0" />
      </HBox>
   </bottom>
</BorderPane>
