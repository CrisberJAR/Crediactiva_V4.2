<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.admin.ValidarCobrosController" fitToWidth="true" hbarPolicy="NEVER">
   <content>
      <VBox spacing="12.0">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
   
   <Label text="✅ Validar Cobros Pendientes" styleClass="title-label">
      <font>
         <Font size="18.0" />
      </font>
   </Label>
   
   <!-- Filtros -->
   <VBox spacing="8.0" styleClass="form-section">
      <Label text="Filtros" styleClass="section-title" />
      
      <HBox spacing="12.0" alignment="CENTER_LEFT">
         <Label text="Asesor:" />
         <ComboBox fx:id="cmbAsesor" promptText="Todos los asesores" prefWidth="200.0" />
         
         <Label text="Fecha:" />
         <DatePicker fx:id="dpFecha" prefWidth="150.0" />
         
         <Button fx:id="btnFiltrar" onAction="#handleFiltrar" text="Filtrar" />
         <Button fx:id="btnLimpiarFiltros" onAction="#handleLimpiarFiltros" text="Limpiar" />
      </HBox>
   </VBox>
   
   <!-- Resumen de cobros pendientes -->
   <VBox spacing="8.0" styleClass="form-section">
      <Label text="Resumen de Cobros Pendientes" styleClass="section-title" />
      
      <GridPane hgap="12.0" vgap="8.0">
         <columnConstraints>
            <ColumnConstraints minWidth="140.0" />
            <ColumnConstraints minWidth="180.0" />
            <ColumnConstraints minWidth="140.0" />
            <ColumnConstraints minWidth="180.0" />
         </columnConstraints>
         
         <Label text="Total de Cobros:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
         <Label fx:id="lblTotalCobros" text="0" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="0" />
         
         <Label text="Monto Total:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
         <Label fx:id="lblMontoTotal" text="S/ 0.00" styleClass="stat-value" GridPane.columnIndex="3" GridPane.rowIndex="0" />
         
         <Label text="Cobros Validados:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
         <Label fx:id="lblCobrosValidados" text="0" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         
         <Label text="Cobros Pendientes:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         <Label fx:id="lblCobrosPendientes" text="0" styleClass="stat-value" GridPane.columnIndex="3" GridPane.rowIndex="1" />
      </GridPane>
   </VBox>
   
   <!-- Tabla de cobros pendientes -->
   <VBox spacing="10.0" styleClass="form-section">
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <Label text="Cobros Pendientes de Validación" styleClass="section-title" />
         <Region HBox.hgrow="ALWAYS" />
         <Button fx:id="btnValidarTodos" onAction="#handleValidarTodos" styleClass="primary-button" text="Validar Todos" />
         <Button fx:id="btnRechazarTodos" onAction="#handleRechazarTodos" styleClass="danger-button" text="Rechazar Todos" />
      </HBox>
      
      <TableView fx:id="tblCobrosPendientes" prefHeight="350.0" minHeight="300.0">
         <columns>
            <TableColumn fx:id="colIdCobro" text="ID" prefWidth="60.0" />
            <TableColumn fx:id="colAsesor" text="Asesor" prefWidth="150.0" />
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200.0" />
            <TableColumn fx:id="colPrestamo" text="Préstamo ID" prefWidth="100.0" />
            <TableColumn fx:id="colMonto" text="Monto" prefWidth="120.0" />
            <TableColumn fx:id="colFechaRegistro" text="Fecha Registro" prefWidth="120.0" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0" />
         </columns>
      </TableView>
   </VBox>
   
   <!-- Detalles del cobro seleccionado -->
   <VBox spacing="8.0" styleClass="form-section">
      <Label text="Detalles del Cobro Seleccionado" styleClass="section-title" />
      
      <GridPane hgap="12.0" vgap="8.0">
         <columnConstraints>
            <ColumnConstraints minWidth="120.0" />
            <ColumnConstraints minWidth="180.0" />
            <ColumnConstraints minWidth="120.0" />
            <ColumnConstraints minWidth="180.0" />
         </columnConstraints>
         
         <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
         <Label fx:id="lblClienteDetalle" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
         
         <Label text="Asesor:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
         <Label fx:id="lblAsesorDetalle" text="-" GridPane.columnIndex="3" GridPane.rowIndex="0" />
         
         <Label text="Préstamo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
         <Label fx:id="lblPrestamoDetalle" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         
         <Label text="Número de Cuota:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
         <Label fx:id="lblNumeroCuotaDetalle" text="-" GridPane.columnIndex="3" GridPane.rowIndex="1" />
         
         <Label text="Monto:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
         <Label fx:id="lblMontoDetalle" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         
         <Label text="Saldo Pendiente:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
         <Label fx:id="lblSaldoPendienteDetalle" text="-" GridPane.columnIndex="3" GridPane.rowIndex="2" />
         
         <Label text="Fecha Registro:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
         <Label fx:id="lblFechaPagoDetalle" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      </GridPane>
      
      <!-- Observaciones -->
      <VBox spacing="5.0">
         <Label text="Observaciones:" />
         <TextArea fx:id="txtObservaciones" promptText="Ingrese observaciones sobre la validación..." prefRowCount="2" />
      </VBox>
      
      <!-- Botones de acción -->
      <HBox spacing="10.0" alignment="CENTER_RIGHT">
         <Button fx:id="btnValidarCobro" onAction="#handleValidarCobro" styleClass="success-button" text="✅ Validar Cobro" />
         <Button fx:id="btnRechazarCobro" onAction="#handleRechazarCobro" styleClass="danger-button" text="❌ Rechazar Cobro" />
         <Button fx:id="btnActualizar" onAction="#handleActualizar" text="🔄 Actualizar" />
      </HBox>
   </VBox>
      </VBox>
   </content>
</ScrollPane>
