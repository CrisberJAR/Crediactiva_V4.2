<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.asesor.PrestamosActivosController" spacing="15.0">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   
   <Label text="Préstamos Activos" styleClass="title-label">
      <font>
         <Font size="18.0" />
      </font>
   </Label>
   
   <!-- Resumen de préstamos activos -->
   <HBox spacing="20.0" alignment="CENTER_LEFT">
      <VBox spacing="10.0" styleClass="stat-card" prefWidth="200.0">
         <Label text="📊" styleClass="stat-icon" />
         <Label text="Total Préstamos Activos" styleClass="stat-label" />
         <Label fx:id="lblTotalPrestamosActivos" text="0" styleClass="stat-value" />
      </VBox>
      
      <VBox spacing="10.0" styleClass="stat-card" prefWidth="200.0">
         <Label text="💰" styleClass="stat-icon" />
         <Label text="Monto Total Desembolsado" styleClass="stat-label" />
         <Label fx:id="lblMontoTotalDesembolsado" text="S/ 0.00" styleClass="stat-value" />
      </VBox>
      
      <VBox spacing="10.0" styleClass="stat-card" prefWidth="200.0">
         <Label text="📈" styleClass="stat-icon" />
         <Label text="Recaudación del Mes" styleClass="stat-label" />
         <Label fx:id="lblRecaudacionMes" text="S/ 0.00" styleClass="stat-value" />
      </VBox>
      
      <VBox spacing="10.0" styleClass="stat-card" prefWidth="200.0">
         <Label text="⚠️" styleClass="stat-icon" />
         <Label text="Morosidad" styleClass="stat-label" />
         <Label fx:id="lblMorosidad" text="0.00%" styleClass="stat-value" />
      </VBox>
   </HBox>
   
   <!-- Filtros y búsqueda -->
   <HBox spacing="10.0" alignment="CENTER_LEFT">
      <Label text="Buscar:" />
      <TextField fx:id="txtBuscar" promptText="Nombre del cliente o DNI" prefWidth="250.0" />
      <Button fx:id="btnBuscar" onAction="#handleBuscar" text="Buscar" styleClass="secondary-button" />
      <Button fx:id="btnLimpiar" onAction="#handleLimpiar" text="Limpiar" styleClass="secondary-button" />
      <Separator orientation="VERTICAL" />
      <Label text="Filtrar por:" />
      <ComboBox fx:id="cmbFiltro" promptText="Todos los préstamos" prefWidth="150.0" />
      <Button fx:id="btnFiltrar" onAction="#handleFiltrar" text="Filtrar" styleClass="secondary-button" />
   </HBox>
   
   <!-- Tabla de préstamos activos -->
   <TableView fx:id="tblPrestamosActivos" prefHeight="400.0">
      <columns>
         <TableColumn fx:id="colIdPrestamo" text="ID Préstamo" prefWidth="100.0" />
         <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200.0" />
         <TableColumn fx:id="colMontoSolicitado" text="Monto Solicitado" prefWidth="130.0" />
         <TableColumn fx:id="colMontoDesembolsado" text="Monto Desembolsado" prefWidth="140.0" />
         <TableColumn fx:id="colTasaInteres" text="Tasa Interés" prefWidth="100.0" />
         <TableColumn fx:id="colNumeroCuotas" text="N° Cuotas" prefWidth="80.0" />
         <TableColumn fx:id="colTipoPago" text="Tipo Pago" prefWidth="100.0" />
         <TableColumn fx:id="colFechaInicio" text="Fecha Inicio" prefWidth="120.0" />
         <TableColumn fx:id="colFechaFin" text="Fecha Fin" prefWidth="120.0" />
         <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0" />
      </columns>
   </TableView>
   
   <!-- Botones de acción -->
   <HBox spacing="10.0" alignment="CENTER_LEFT">
      <Button fx:id="btnVerDetalles" onAction="#handleVerDetalles" text="Ver Detalles" styleClass="primary-button" />
      <Button fx:id="btnVerCronograma" onAction="#handleVerCronograma" text="Ver Cronograma" styleClass="secondary-button" />
      <Button fx:id="btnActualizar" onAction="#handleActualizar" text="Actualizar" styleClass="secondary-button" />
   </HBox>
   
   <!-- Información de paginación -->
   <HBox alignment="CENTER" spacing="10.0">
      <Label fx:id="lblInfoPaginacion" text="Mostrando 0 de 0 préstamos" />
      <Button fx:id="btnAnterior" onAction="#handleAnterior" text="Anterior" />
      <Button fx:id="btnSiguiente" onAction="#handleSiguiente" text="Siguiente" />
   </HBox>
</VBox>
