<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.cliente.HistorialClienteController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button fx:id="btnVolver" onAction="#handleVolver" styleClass="modern-button" text="← Volver" />
            <Label text="Mi Historial" styleClass="section-title" />
         </HBox>
         
         <Label text="Consulta tu historial completo de préstamos y pagos" styleClass="modern-label subtitle" />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" vbarPolicy="NEVER">
         <VBox spacing="20.0">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- Panel de filtros -->
            <VBox spacing="15.0" styleClass="modern-card">
               <Label text="Filtros de Búsqueda" styleClass="section-title" />
               
               <GridPane hgap="15.0" vgap="15.0">
                  <columnConstraints>
                     <ColumnConstraints minWidth="150.0" />
                     <ColumnConstraints />
                     <ColumnConstraints minWidth="150.0" />
                     <ColumnConstraints />
                  </columnConstraints>
                  
                  <Label text="Estado del préstamo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <ComboBox fx:id="comboEstado" onAction="#handleFiltrar" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="combo-box" />
                  
                  <Label text="Fecha desde:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <DatePicker fx:id="dateDesde" onAction="#handleFiltrar" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="date-picker" />
                  
                  <Label text="Fecha hasta:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <DatePicker fx:id="dateHasta" onAction="#handleFiltrar" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="date-picker" />
                  
                  <Label text="Monto mínimo:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="txtMontoMinimo" onKeyReleased="#handleFiltrar" prefWidth="120.0" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="form-field" />
               </GridPane>
               
               <HBox spacing="10.0" alignment="CENTER">
                  <Button fx:id="btnBuscar" onAction="#handleBuscar" styleClass="modern-button" text="Buscar" />
                  <Button fx:id="btnLimpiar" onAction="#handleLimpiar" styleClass="quick-action-button" text="Limpiar Filtros" />
               </HBox>
            </VBox>
            
            <!-- Panel de resumen estadístico -->
            <VBox spacing="15.0" styleClass="modern-card">
               <Label text="Resumen Estadístico" styleClass="section-title" />
               
               <GridPane hgap="20.0" vgap="15.0">
                  <columnConstraints>
                     <ColumnConstraints minWidth="200.0" />
                     <ColumnConstraints />
                     <ColumnConstraints minWidth="200.0" />
                     <ColumnConstraints />
                  </columnConstraints>
                  
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <Label text="Total Préstamos" styleClass="stat-label" />
                     <Label fx:id="lblTotalPrestamos" text="0" styleClass="stat-value" />
                     <Label text="Histórico" styleClass="stat-description" />
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card success" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <Label text="Préstamos Pagados" styleClass="stat-label" />
                     <Label fx:id="lblPrestamosPagados" text="0" styleClass="stat-value" />
                     <Label text="Completados" styleClass="stat-description" />
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card warning" GridPane.columnIndex="2" GridPane.rowIndex="0">
                     <Label text="Total Pagado" styleClass="stat-label" />
                     <Label fx:id="lblTotalPagado" text="S/ 0.00" styleClass="stat-value" />
                     <Label text="Acumulado" styleClass="stat-description" />
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="5.0" styleClass="stat-card info" GridPane.columnIndex="3" GridPane.rowIndex="0">
                     <Label text="Capital Acumulado" styleClass="stat-label" />
                     <Label fx:id="lblCapitalAcumulado" text="S/ 0.00" styleClass="stat-value" />
                     <Label text="Retenido" styleClass="stat-description" />
                  </VBox>
               </GridPane>
            </VBox>
            
            <!-- Panel de historial de préstamos -->
            <VBox spacing="15.0" styleClass="modern-card">
               <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <Label text="Historial de Préstamos" styleClass="section-title" />
                  <Label fx:id="lblTotalResultados" styleClass="modern-label info" />
               </HBox>
               
               <TableView fx:id="tablaHistorial" prefHeight="400.0" styleClass="table-view">
                  <columns>
                     <TableColumn fx:id="colNumeroPrestamo" prefWidth="120.0" text="Préstamo" />
                     <TableColumn fx:id="colMontoSolicitado" prefWidth="120.0" text="Monto Solicitado" />
                     <TableColumn fx:id="colTasaInteres" prefWidth="100.0" text="Tasa %" />
                     <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                     <TableColumn fx:id="colFechaInicio" prefWidth="120.0" text="Fecha Inicio" />
                     <TableColumn fx:id="colFechaFin" prefWidth="120.0" text="Fecha Fin" />
                     <TableColumn fx:id="colEtiqueta" prefWidth="100.0" text="Etiqueta" />
                     <TableColumn fx:id="colAcciones" prefWidth="120.0" text="Acciones" />
                  </columns>
               </TableView>
            </VBox>
            
            <!-- Panel de historial de pagos -->
            <VBox spacing="15.0" styleClass="modern-card">
               <Label text="Historial de Pagos" styleClass="section-title" />
               
               <TableView fx:id="tablaPagos" prefHeight="300.0" styleClass="table-view">
                  <columns>
                     <TableColumn fx:id="colFechaPago" prefWidth="120.0" text="Fecha Pago" />
                     <TableColumn fx:id="colNumeroCuota" prefWidth="100.0" text="Cuota" />
                     <TableColumn fx:id="colMontoPagado" prefWidth="120.0" text="Monto Pagado" />
                     <TableColumn fx:id="colPrestamoPago" prefWidth="120.0" text="Préstamo" />
                     <TableColumn fx:id="colEstadoPago" prefWidth="100.0" text="Estado" />
                  </columns>
               </TableView>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox alignment="CENTER" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>
         
         <Label fx:id="lblUltimaActualizacion" text="Última actualización: " styleClass="modern-label info" />
      </HBox>
   </bottom>
</BorderPane>
