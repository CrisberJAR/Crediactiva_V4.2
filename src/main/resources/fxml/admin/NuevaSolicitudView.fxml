<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.crediactiva.app.view.admin.NuevaSolicitudController">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Label styleClass="title-label" text="Nueva Solicitud de Préstamo">
            <font>
               <Font size="18.0" />
            </font>
         </Label>
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true">
         <VBox spacing="20.0">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- Información del Cliente -->
            <GroupBox text="Información del Cliente">
               <VBox spacing="10.0">
                  <padding>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
                  
                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <Label text="DNI del Cliente:" prefWidth="120.0" />
                     <TextField fx:id="txtDniCliente" prefWidth="150.0" promptText="Ingrese DNI" />
                     <Button fx:id="btnBuscarCliente" onAction="#handleBuscarCliente" text="Buscar Cliente" />
                  </HBox>
                  
                  <GridPane hgap="10.0" vgap="10.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                        <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                     </rowConstraints>
                     
                     <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                     <Label fx:id="lblNombreCliente" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                     <Label text="Apellido:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                     <Label fx:id="lblApellidoCliente" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                     
                     <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                     <Label fx:id="lblTelefonoCliente" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                     <Label fx:id="lblEmailCliente" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                     
                     <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                     <Label fx:id="lblDireccionCliente" GridPane.columnIndex="1" GridPane.rowIndex="2" colspan="3" />
                     
                     <Label text="Capital Acumulado:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                     <Label fx:id="lblCapitalCliente" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     <Label text="Etiqueta:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                     <Label fx:id="lblEtiquetaCliente" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                  </GridPane>
               </VBox>
            </GroupBox>
            
            <!-- Información del Asesor -->
            <GroupBox text="Información del Asesor">
               <VBox spacing="10.0">
                  <padding>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
                  
                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <Label text="Asesor:" prefWidth="120.0" />
                     <ComboBox fx:id="comboAsesor" prefWidth="300.0" promptText="Seleccione un asesor" />
                  </HBox>
               </VBox>
            </GroupBox>
            
            <!-- Información del Préstamo -->
            <GroupBox text="Información del Préstamo">
               <VBox spacing="10.0">
                  <padding>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
                  
                  <GridPane hgap="10.0" vgap="10.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                        <ColumnConstraints hgrow="NEVER" minWidth="150.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                        <RowConstraints minHeight="30.0" vgrow="NEVER" />
                     </rowConstraints>
                     
                     <Label text="Monto Solicitado (S/):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                     <TextField fx:id="txtMontoSolicitado" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                     <Label text="Tasa de Interés (%):" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                     <TextField fx:id="txtTasaInteres" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                     
                     <Label text="Período (meses):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                     <TextField fx:id="txtPeriodo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     <Label text="Tipo de Pago:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                     <ComboBox fx:id="comboTipoPago" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                     
                     <Label text="Monto Desembolsado (S/):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                     <Label fx:id="lblMontoDesembolsado" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     <Label text="Capital Retenido (S/):" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                     <Label fx:id="lblCapitalRetenido" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                     
                     <Label text="Monto Total a Pagar (S/):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                     <Label fx:id="lblMontoTotal" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     <Label text="Valor de Cuota (S/):" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                     <Label fx:id="lblValorCuota" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                     
                     <Label text="Fecha de Inicio:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                     <DatePicker fx:id="dateFechaInicio" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                     <Label text="Fecha de Fin:" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                     <DatePicker fx:id="dateFechaFin" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                     
                     <Label text="Observaciones:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                     <TextArea fx:id="txtObservaciones" GridPane.columnIndex="1" GridPane.rowIndex="5" colspan="3" prefRowCount="3" />
                  </GridPane>
               </VBox>
            </GroupBox>
            
            <!-- Cronograma Preview -->
            <GroupBox text="Vista Previa del Cronograma">
               <VBox spacing="10.0">
                  <padding>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
                  
                  <TableView fx:id="tablaCronograma" prefHeight="200.0">
                     <columns>
                        <TableColumn fx:id="colNumeroCuota" prefWidth="80.0" text="Cuota" />
                        <TableColumn fx:id="colFechaProgramada" prefWidth="120.0" text="Fecha Programada" />
                        <TableColumn fx:id="colMontoCuota" prefWidth="120.0" text="Monto Cuota" />
                        <TableColumn fx:id="colEstadoCuota" prefWidth="100.0" text="Estado" />
                     </columns>
                  </TableView>
               </VBox>
            </GroupBox>
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Button fx:id="btnCalcular" onAction="#handleCalcular" styleClass="primary-button" text="Calcular" />
         <Button fx:id="btnGuardar" onAction="#handleGuardar" styleClass="success-button" text="Guardar Solicitud" />
         <Button fx:id="btnLimpiar" onAction="#handleLimpiar" text="Limpiar Formulario" />
         <Button fx:id="btnCancelar" onAction="#handleCancelar" text="Cancelar" />
      </HBox>
   </bottom>
</BorderPane>
