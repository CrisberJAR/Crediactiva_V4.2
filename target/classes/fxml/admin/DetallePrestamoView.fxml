<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="pe.crediactiva.app.view.admin.DetallePrestamoController" 
            prefHeight="600.0" prefWidth="800.0" minHeight="500.0" minWidth="700.0">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Label styleClass="title-label" text="Detalle de Préstamo">
            <font>
               <Font size="18.0" />
            </font>
         </Label>
         
         <Label text="Revise los datos del préstamo y tome una decisión" />
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true">
         <VBox spacing="15.0">
            <padding>
               <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            
            <!-- Información del préstamo -->
            <GridPane hgap="15.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" minWidth="150.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                  <ColumnConstraints hgrow="NEVER" minWidth="150.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="35.0" vgrow="NEVER" />
                  <RowConstraints minHeight="35.0" vgrow="NEVER" />
                  <RowConstraints minHeight="35.0" vgrow="NEVER" />
                  <RowConstraints minHeight="35.0" vgrow="NEVER" />
                  <RowConstraints minHeight="35.0" vgrow="NEVER" />
                  <RowConstraints minHeight="35.0" vgrow="NEVER" />
               </rowConstraints>
               
               <Label text="ID Préstamo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <Label fx:id="lblIdPrestamo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               <Label text="Cliente:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
               <Label fx:id="lblCliente" GridPane.columnIndex="3" GridPane.rowIndex="0" />
               
               <Label text="Asesor:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
               <Label fx:id="lblAsesor" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
               <Label fx:id="lblEstado" GridPane.columnIndex="3" GridPane.rowIndex="1" />
               
               <Label text="Monto Solicitado:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
               <TextField fx:id="txtMontoSolicitado" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <Label text="Monto Desembolsado:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
               <TextField fx:id="txtMontoDesembolsado" GridPane.columnIndex="3" GridPane.rowIndex="2" />
               
               <Label text="Tasa de Interés:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
               <TextField fx:id="txtTasaInteres" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               <Label text="Período (meses):" GridPane.columnIndex="2" GridPane.rowIndex="3" />
               <TextField fx:id="txtPeriodo" GridPane.columnIndex="3" GridPane.rowIndex="3" />
               
               <Label text="Tipo de Pago:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
               <ComboBox fx:id="comboTipoPago" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               <Label text="Fecha Solicitud:" GridPane.columnIndex="2" GridPane.rowIndex="4" />
               <Label fx:id="lblFechaSolicitud" GridPane.columnIndex="3" GridPane.rowIndex="4" />
               
               <Label text="Observación:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
               <TextField fx:id="txtObservacion" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5" />
            </GridPane>
            
            <!-- Información adicional del cliente -->
            <VBox spacing="10.0">
               <Label text="Información del Cliente:" styleClass="subtitle-label">
                  <font>
                     <Font size="14.0" />
                  </font>
               </Label>
               
               <GridPane hgap="15.0" vgap="8.0">
                  <columnConstraints>
                     <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                     <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                     <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                     <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints minHeight="25.0" vgrow="NEVER" />
                     <RowConstraints minHeight="25.0" vgrow="NEVER" />
                     <RowConstraints minHeight="25.0" vgrow="NEVER" />
                  </rowConstraints>
                  
                  <Label text="DNI:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <Label fx:id="lblDniCliente" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Teléfono:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <Label fx:id="lblTelefonoCliente" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                  
                  <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <Label fx:id="lblDireccionCliente" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
                  
                  <Label text="Etiqueta:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <Label fx:id="lblEtiquetaCliente" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Historial:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <Button fx:id="btnVerHistorial" onAction="#handleVerHistorial" text="Ver Historial" GridPane.columnIndex="3" GridPane.rowIndex="2" />
               </GridPane>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox alignment="CENTER" spacing="15.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         
         <Button fx:id="btnAprobar" onAction="#handleAprobar" styleClass="success-button" text="Aprobar Préstamo" />
         <Button fx:id="btnRechazar" onAction="#handleRechazar" styleClass="danger-button" text="Rechazar Préstamo" />
         <Button fx:id="btnGuardar" onAction="#handleGuardar" styleClass="primary-button" text="Guardar Cambios" />
         <Button fx:id="btnCerrar" onAction="#handleCerrar" text="Cerrar" />
      </HBox>
   </bottom>
</BorderPane>
