<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="pe.crediactiva.app.view.admin.BandejaSolicitudesController" 
            prefHeight="700.0" prefWidth="1000.0" minHeight="600.0" minWidth="800.0">
   <top>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Label styleClass="title-label" text="Solicitudes de Préstamo Pendientes">
            <font>
               <Font size="18.0" />
            </font>
         </Label>
         
         <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Haga doble clic en una fila para ver los detalles" />
            <Button fx:id="btnActualizar" onAction="#handleActualizar" text="Actualizar" />
         </HBox>
      </VBox>
   </top>
   
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <!-- Tabla de solicitudes -->
         <TableView fx:id="tablaSolicitudes" prefHeight="500.0">
            <columns>
               <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
               <TableColumn fx:id="colCliente" prefWidth="200.0" text="Cliente" />
               <TableColumn fx:id="colAsesor" prefWidth="200.0" text="Asesor" />
               <TableColumn fx:id="colMonto" prefWidth="150.0" text="Monto Solicitado" />
               <TableColumn fx:id="colObservacion" prefWidth="300.0" text="Motivo/Observación" />
               <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha Solicitud" />
            </columns>
         </TableView>
      </VBox>
   </center>
   
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Label fx:id="lblTotalSolicitudes" text="Total: 0 solicitudes" />
         <Label fx:id="lblSolicitudesPendientes" text="Pendientes: 0" />
      </HBox>
   </bottom>
</BorderPane>
